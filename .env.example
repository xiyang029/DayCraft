# DayCraft 环境变量模板：cp .env.example .env 后按需修改
# 注意：.env 已被 git 忽略，不要提交真实密钥。

# ===== 后端（server/，Express）=====
# 服务端口（仅生产生效；开发 server 固定 :3001）
PORT=3000

# 本地 SQLite 数据库（相对路径相对仓库根解析）
SQLITE_DB_PATH=./data/daycraft.db

# 会话 JWT 签名密钥（生产环境务必改为随机长字符串）
AUTH_SECRET=daycraft-local-secret-please-change

# 会话 Cookie 的 Secure 标记：仅 HTTPS 对外服务时设 true；
# 局域网 HTTP 部署必须保持注释/非 true，否则浏览器不发 Cookie、登录态失效
# COOKIE_SECURE=true

# 站点 URL（留空按请求 Host 自动判断）
# SITE_URL=

# 新用户 AI 默认设置（注册时写入 user_ai_settings，仅自定义 AI）
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-openai-api-key
AI_MODEL_NAME=gpt-3.5-turbo
AI_SYSTEM_PROMPT=你是一个智能助手，可以帮助用户生成日报、周报和月报。请根据用户提供的信息，生成专业、简洁的报告内容。
AI_USER_PROMPT=请根据我的工作内容，生成一份专业的{report_type}。以下是我的工作记录：\n\n{report_content}

# ===== 前端（client/，Vite，构建时烘焙 VITE_*）=====
# VITE_API_PROXY 仅开发期有效：vite dev 将 /api 代理到该地址
VITE_API_PROXY=http://localhost:3001

# NODE_ENV 无需在此设置：Docker 由 Dockerfile 的 runner 阶段 ENV 指定，
# 本地 pnpm start 由根 package.json 的 cross-env 指定。
